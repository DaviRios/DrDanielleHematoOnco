<div id="page-loader" class="page-loader" role="status" aria-live="polite" aria-atomic="true">
  <div class="page-loader__content">
    <div class="page-loader__mark" aria-hidden="true">
      <img src="/brand-mark.svg" width="80" height="150" alt="">
    </div>
    <p>Preparando este espaço para você</p>
    <div class="page-loader__track" aria-hidden="true">
      <span></span>
    </div>
  </div>
</div>

<noscript>
  <style>
  .page-loader {
    display: none;
  }
  </style>
</noscript>

<script is:inline>
(() => {
  const root = document.documentElement;
  const loader = document.getElementById('page-loader');
  const minimumVisibleTime = 550;

  const showLoader = () => {
    root.dataset.loadStartedAt = String(performance.now());
    root.classList.add('page-is-loading');
    loader?.removeAttribute('aria-hidden');
    document.body.setAttribute('aria-busy', 'true');
  };

  const hideLoader = () => {
    const startedAt = Number(root.dataset.loadStartedAt ?? performance.now());
    const remainingTime = Math.max(0, minimumVisibleTime - (performance.now() - startedAt));

    window.setTimeout(() => {
      root.classList.remove('page-is-loading');
      loader?.setAttribute('aria-hidden', 'true');
      document.body.setAttribute('aria-busy', 'false');
    }, remainingTime);
  };

  if (document.readyState === 'complete') {
    hideLoader();
  } else {
    window.addEventListener('load', hideLoader, { once: true });
  }

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) hideLoader();
  });

  window.addEventListener('beforeunload', showLoader);
})();
</script>

<style>
.page-loader {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  visibility: hidden;
  place-items: center;
  background:
    radial-gradient(circle at 16% 12%, var(--blush) 0 12rem, transparent 12.1rem),
    radial-gradient(
      circle at 88% 84%,
      transparent 0 11rem,
      rgba(24, 52, 76, 0.09) 11.05rem 11.12rem,
      transparent 11.17rem
    ),
    var(--paper);
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 280ms ease,
    visibility 280ms ease;
}

:global(html.page-is-loading) {
  overflow: hidden;
}

:global(html.page-is-loading) .page-loader {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
}

.page-loader__content {
  display: grid;
  width: min(24rem, calc(100% - 3rem));
  justify-items: center;
  text-align: center;
}

.page-loader__mark {
  position: relative;
  display: grid;
  width: 8.5rem;
  aspect-ratio: 1;
  place-items: center;
  border: 1px solid rgba(152, 31, 36, 0.2);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
}

.page-loader__mark::after {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid transparent;
  border-top-color: var(--wine);
  border-radius: 50%;
  content: "";
  animation: loader-spin 1.1s linear infinite;
}

.page-loader__mark img {
  width: 3.4rem;
  height: auto;
}

.page-loader p {
  margin: 1.35rem 0 0;
  color: var(--ink);
  font-family: var(--display);
  font-size: 1.15rem;
}

.page-loader__track {
  width: 9rem;
  height: 2px;
  margin-top: 1rem;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(152, 31, 36, 0.14);
}

.page-loader__track span {
  display: block;
  width: 42%;
  height: 100%;
  border-radius: inherit;
  background: var(--wine);
  animation: loader-progress 1.05s ease-in-out infinite;
}

@keyframes loader-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes loader-progress {
  from {
    transform: translateX(-120%);
  }

  to {
    transform: translateX(340%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page-loader,
  .page-loader__mark::after,
  .page-loader__track span {
    transition: none;
    animation: none;
  }

  .page-loader__track span {
    width: 100%;
  }
}
</style>
