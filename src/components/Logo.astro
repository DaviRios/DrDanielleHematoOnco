---
interface Props {
  compact?: boolean;
  light?: boolean;
}

const { compact = false, light = false } = Astro.props;
---

<a
  class:list={['logo', { 'logo--compact': compact, 'logo--light': light }]}
  href="/"
  aria-label="Danielle Godoy — página inicial"
>
  <img class="logo__mark" src="/brand-mark.svg" width="80" height="150" alt="" aria-hidden="true">
  <span class="logo__copy">
    <strong>Danielle Godoy</strong>
    <small>Oncologia e Hematologia Veterinária</small>
  </span>
</a>

<style>
.logo {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  color: var(--ink);
  text-decoration: none;
}

.logo__mark {
  width: 2.35rem;
  height: 3.35rem;
  flex: 0 0 auto;
  object-fit: contain;
}

.logo__copy {
  display: grid;
  line-height: 1.05;
}

.logo__copy strong {
  font-family: var(--display);
  font-size: clamp(1.2rem, 2vw, 1.55rem);
  letter-spacing: -0.025em;
}

.logo__copy small {
  margin-top: 0.3rem;
  font-family: var(--display);
  font-size: 0.59rem;
  letter-spacing: 0.01em;
}

.logo--compact .logo__mark {
  width: 2.05rem;
  height: 2.85rem;
}

.logo--light {
  color: var(--white);
}

.logo--light .logo__mark {
  filter: brightness(0) saturate(100%) invert(88%) sepia(12%) saturate(778%) hue-rotate(306deg) brightness(104%)
    contrast(90%);
}

@media (max-width: 420px) {
  .logo__copy small {
    display: none;
  }
}
</style>
