---
import FeedbackCarousel from './FeedbackCarousel';
import './FeedbackCarousel.css';
import { siteConfig } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['feedback-wrap', { 'feedback-wrap--compact': compact }]}>
  {siteConfig.feedbacks.length === 0 && (
    <div class="feedback-empty" role="status">
      <span class="feedback-empty__mark" aria-hidden="true">
        “
      </span>
      <div>
        <p class="feedback-empty__label">Espaço preparado</p>
        <h2>Os feedbacks serão adicionados aqui.</h2>
        <p>A seção já está pronta para receber relatos autorizados, sem publicar nomes ou experiências fictícias.</p>
      </div>
    </div>
  )}
  {siteConfig.feedbacks.length > 0 && <FeedbackCarousel feedbacks={siteConfig.feedbacks} client:visible />}
</div>

<style>
.feedback-wrap {
  width: 100%;
}

.feedback-wrap--compact {
  max-width: 930px;
  margin-inline: auto;
}
</style>
