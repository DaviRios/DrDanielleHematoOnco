---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <Logo light />
      <p>Informação clara, escuta atenta e cuidado especializado em cada etapa.</p>
    </div>

    <div>
      <h2>Navegação</h2>
      <nav aria-label="Navegação do rodapé">
        <a href="/">Home</a>
        <a href="/informacoes">Informações</a>
        <a href="/locais">Locais de atendimento</a>
        <a href="/contato">Contato</a>
      </nav>
    </div>

    <div>
      <h2>Especialidade</h2>
      <p>Oncologia e Hematologia Veterinária</p>
      <a class="footer-link" href="/feedbacks">Ver feedbacks →</a>
    </div>
  </div>
  <div class="site-shell footer-bottom">
    <p>© {year} Danielle Godoy. Todos os direitos reservados.</p>
    <p>Conteúdo informativo — não substitui avaliação veterinária.</p>
  </div>
</footer>

<style>
.site-footer {
  overflow: hidden;
  background: var(--ink);
  color: rgba(255, 255, 255, 0.76);
  padding: 4.5rem 0 1.5rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 0.7fr 0.8fr;
  gap: clamp(2rem, 7vw, 6rem);
}

.footer-brand p {
  max-width: 34ch;
  margin: 1.5rem 0 0;
}

h2 {
  margin: 0 0 1rem;
  color: var(--white);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

nav {
  display: grid;
  gap: 0.65rem;
}

nav a,
.footer-link {
  width: fit-content;
  text-decoration: none;
}

nav a:hover,
.footer-link:hover {
  color: var(--white);
}

.footer-link {
  color: #f2cfd1;
  font-weight: 700;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 4rem;
  border-top: 1px solid rgba(255, 255, 255, 0.13);
  padding-top: 1.35rem;
  font-size: 0.74rem;
}

.footer-bottom p {
  margin: 0;
}

@media (max-width: 760px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-bottom {
    flex-direction: column;
  }
}
</style>
