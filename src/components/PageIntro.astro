---
import FadeInText from '@astroanimate/core/FadeInText';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="page-intro__orb" aria-hidden="true"></div>
  <div class="site-shell page-intro__inner">
    <FadeInText
      as="nav"
      class="breadcrumb"
      aria-label="Navegação estrutural"
      enhance
      duration={0.45}
      delay={0.48}
      yOffset={10}
      blur="3px"
    >
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </FadeInText>
    <FadeInText as="p" class="eyebrow" enhance duration={0.5} delay={0.54} yOffset={12} blur="3px">
      {eyebrow}
    </FadeInText>
    <FadeInText as="h1" class="display-title" enhance duration={0.65} delay={0.6} yOffset={18} blur="5px">
      {title}
    </FadeInText>
    <FadeInText as="p" class="body-large" enhance duration={0.6} delay={0.7} yOffset={16} blur="4px">
      {description}
    </FadeInText>
  </div>
</section>

<style>
.page-intro {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid rgba(24, 52, 76, 0.08);
  background: var(--warm);
}

.page-intro__inner {
  position: relative;
  z-index: 1;
  padding-block: clamp(4.5rem, 10vw, 8.5rem);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  margin-bottom: 1.5rem;
  color: var(--ink-soft);
  font-size: 0.78rem;
}

.breadcrumb a {
  color: var(--wine);
  font-weight: 750;
  text-decoration: none;
}

.breadcrumb a:hover {
  text-decoration: underline;
  text-underline-offset: 0.2rem;
}

.page-intro h1 {
  max-width: 15ch;
}

.page-intro .body-large {
  max-width: 62ch;
  margin: 1.5rem 0 0;
}

.page-intro__orb {
  position: absolute;
  top: -13rem;
  right: -5rem;
  width: 35rem;
  aspect-ratio: 1;
  border: 1px solid rgba(24, 52, 76, 0.12);
  border-radius: 50%;
}

.page-intro__orb::before,
.page-intro__orb::after {
  position: absolute;
  border-radius: 50%;
  content: "";
}

.page-intro__orb::before {
  right: 8rem;
  bottom: 1.3rem;
  width: 5.2rem;
  aspect-ratio: 1;
  background: var(--blush-strong);
}

.page-intro__orb::after {
  right: 5.5rem;
  bottom: 8rem;
  width: 0.7rem;
  aspect-ratio: 1;
  background: var(--wine);
}
</style>
